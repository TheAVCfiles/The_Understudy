{
  "name": "the-understudy-workspace",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "scripts": {
    "preinstall": "sh -c 'rm -f package-lock.json yarn.lock; case \"$npm_config_user_agent\" in pnpm/*) ;; *) echo \"Use pnpm instead\" >&2; exit 1 ;; esac'",
    "dev": "pnpm --filter @workspace/the-understudy run dev",
    "build": "pnpm --filter @workspace/the-understudy run build",
    "typecheck": "pnpm --filter @workspace/the-understudy run typecheck"
  },
  "devDependencies": {
    "typescript": "~5.9.3"
  }
}
